# Server Configuration
PORT=3000
ISSUER_URL=http://localhost:3000
NODE_ENV=development
REQUIRE_HTTPS=false

# Database Configuration (SQLite) — fallback, used only if Supabase vars below are empty
DB_PATH=./data/auth.db



# RS256 Key Pair (Keys are auto-generated into .keys/ if not provided)
# PRIVATE_KEY_PEM=...
# PUBLIC_KEY_PEM=...
KEYS_DIR=./.keys

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-super-secure-change-me!
ADMIN_JWT_SECRET=central-mcp-admin-jwt-secret-replace-in-production

# Token Lifetimes
ACCESS_TOKEN_EXPIRY=3600
STATIC_TOKEN_EXPIRY_DAYS=90
AUTH_CODE_EXPIRY_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200